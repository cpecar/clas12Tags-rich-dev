<gxml>
	<!-- Loading only the RICH mother volume and the MirrorSupport, which causes strange overlaps with spherical mirrors -->
	<!-- The STL files in this directory are the proposed new, simplified volumes -->
	<volume name="AaRICH_m1" color="444444" material="Air_Opt" position="0*cm 0*cm 0*cm" rotation="0 0 0*deg" mother="root" />
	<volume name="MirrorSupport_m1" color="E9C45D" material="CarbonFiber" position="0*cm 0*cm 0*cm" rotation="0 0 0" mother="AaRICH_m1" />
	<volume name="AaRICH_m2" color="444444" material="Air_Opt" position="0*cm 0*cm 0*cm" rotation="0 0 180*deg" mother="root" />
	<volume name="MirrorSupport_m2" color="E9C45D" material="CarbonFiber" position="0*cm 0*cm 0*cm" rotation="0 0 0" mother="AaRICH_m2" />
</gxml>
